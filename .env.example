# Root environment template — copy to services/api/.env and apps/web/.env.local

# Database
DATABASE_URL=postgresql://saloneplate:saloneplate_secret@localhost:5432/saloneplate

# Redis
REDIS_URL=redis://localhost:6379

# API
PORT=4000
NODE_ENV=development
API_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000,http://localhost:8081

# JWT
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Orange Money Sierra Leone (architecture ready)
ORANGE_MONEY_API_URL=https://api.orange.com/orange-money-webpay/sl/v1
ORANGE_MONEY_MERCHANT_KEY=
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
ORANGE_MONEY_RETURN_URL=http://localhost:3000/payments/callback
ORANGE_MONEY_CANCEL_URL=http://localhost:3000/payments/cancel

# Stripe (future)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# NextAuth (web dashboard)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-min-32-chars

# Mobile
EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_SOCKET_URL=http://localhost:4000
