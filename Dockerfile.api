# SalonePlate API — build from monorepo root:
#   docker build -f Dockerfile.api -t saloneplate-api .
FROM node:20-alpine AS builder
WORKDIR /app

COPY package.json package-lock.json ./
COPY packages/shared-types ./packages/shared-types
COPY services/api ./services/api

RUN npm ci
RUN npm run build --workspace=@saloneplate/shared-types
WORKDIR /app/services/api
RUN npx prisma generate
RUN npm run build

FROM node:20-alpine AS runner
WORKDIR /app/services/api

ENV NODE_ENV=production

COPY --from=builder /app/node_modules /app/node_modules
COPY --from=builder /app/packages/shared-types /app/packages/shared-types
COPY --from=builder /app/services/api/dist ./dist
COPY --from=builder /app/services/api/package.json ./package.json
COPY --from=builder /app/services/api/prisma ./prisma

EXPOSE 4000

# Use DIRECT_URL for migrations (avoids pgbouncer/transaction pooler issues),
# then start the API with the normal DATABASE_URL.
CMD ["sh", "-c", "DATABASE_URL=\"$DIRECT_URL\" npx prisma migrate deploy && node dist/src/main.js"]
