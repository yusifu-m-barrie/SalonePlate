# --- Supabase (recommended) ---
# In Supabase: Project → Connect → ORM → Prisma — copy BOTH URLs.
# Use the POOLER URL for DATABASE_URL (IPv4-friendly). Do NOT use db.*.supabase.co alone on Windows.
#
# Transaction pooler (port 6543) — use for DATABASE_URL with Prisma/NestJS:
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connect_timeout=30&pool_timeout=30&connection_limit=5
#
# Session pooler (port 5432) — can cause Prisma pool timeouts; avoid for the API runtime:
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?pgbouncer=true&connect_timeout=30
#
# Direct (port 5432) — optional DIRECT_URL; may fail without Supabase IPv4 add-on:
# DIRECT_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require&connect_timeout=30
#
# Encode special chars in password: @ → %40  # → %23

DATABASE_URL=postgresql://postgres.[PROJECT_REF]:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?pgbouncer=true&connect_timeout=30
DIRECT_URL=postgresql://postgres:YOUR_PASSWORD@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require&connect_timeout=30

# --- Local Postgres (Docker) ---
# DATABASE_URL=postgresql://saloneplate:saloneplate_secret@localhost:5432/saloneplate
# DIRECT_URL=postgresql://saloneplate:saloneplate_secret@localhost:5432/saloneplate

REDIS_DISABLED=true
REDIS_URL=redis://localhost:6379
PORT=4000
NODE_ENV=development
# Public base URL for uploaded images (use your PC Wi‑Fi IP for mobile, e.g. http://172.20.10.5:4000)
API_PUBLIC_URL=http://localhost:4000
# Comma-separated origins; leave unset to allow all (fine for mobile dev)
CORS_ORIGIN=http://localhost:3000,http://localhost:8081
JWT_SECRET=dev-secret-change-in-production-min-32-chars
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-production-min-32
JWT_EXPIRES_IN=15m
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
ORANGE_MONEY_API_URL=https://api.orange.com/orange-money-webpay/sl/v1
ORANGE_MONEY_MERCHANT_KEY=
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=

# Google OAuth (same Web client ID as mobile EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID)
GOOGLE_CLIENT_ID=

# Email verification (SMTP) — required for production sign-up emails
# Gmail example: SMTP_HOST=smtp.gmail.com SMTP_PORT=587 SMTP_SECURE=false
# Use an App Password (Google Account → Security → 2-Step → App passwords)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=SalonePlate <your@gmail.com>
# Without SMTP_HOST, codes print to the API terminal in development only.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SalonePlate <noreply@saloneplate.sl>
