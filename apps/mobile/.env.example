EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
EXPO_PUBLIC_SOCKET_URL=http://localhost:4000

# For physical device testing, use your machine's LAN IP:
# EXPO_PUBLIC_API_URL=http://192.168.1.100:4000/api/v1

# Set when expo.dev is unreachable (firewall/VPN/offline) to avoid "fetch failed" on start
EXPO_NO_DEPENDENCY_VALIDATION=1

# Google Sign-In (optional — leave blank to use email sign-up only)
# Google Cloud Console → APIs & Services → Credentials
# Web client ID (required if using Google at all):
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS client ID — required on iPhone/Expo Go; can match Web ID for testing:
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Android client ID — required on Android; can match Web ID for testing:
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
